# AlphaDesk configuration — copy to the repo root as .env and fill in.
# If you add keys, chmod 600 .env
# ──────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────
# Seals every reader's vendor keys in the database: 32 random bytes, base64.
#   python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
# Losing it makes every stored key unreadable.
ALPHADESK_VAULT_KEY=

# SEC EDGAR needs no key but REQUIRES a descriptive User-Agent with contact
# details; without one SEC throttles and then blocks the address for minutes.
SEC_USER_AGENT=AlphaDesk (you@example.com)

# ── Vendor keys: NONE on the server ──────────────────────────────────────────
# Every market figure and headline comes from a key the signed-in reader
# connects on the Account page. Development only: put your own keys here as
# ALPACA_API_KEY, ALPACA_SECRET_KEY, POLYGON_API_KEY, FINNHUB_API_KEY,
# ALPHAVANTAGE_API_KEY, FMP_API_KEY, COINGECKO_API_KEY and seal them into the
# open instance's local account with
#   python -m alphadesk.main keys import-env
# The server never reads them at request time.

# ── Storage ──────────────────────────────────────────────────────────────────
ALPHADESK_DATA=~/.alphadesk        # SQLite ledger + the SEC symbol-list cache
# ALPHADESK_DATABASE_URL=          # Postgres instead (production: Cloud SQL)

# ── Server ───────────────────────────────────────────────────────────────────
DASHBOARD_HOST=127.0.0.1           # 0.0.0.0 when serving beyond localhost
DASHBOARD_PORT=8000                # Cloud Run injects PORT; the image maps it

# ── Sign-in (COMPULSORY by default) ──────────────────────────────────────────
# With any identity provider configured, single sign-on is the only door and
# is also sign-up. Without one, add password accounts first:
#   python -m alphadesk.main user add you@example.com
# ALPHADESK_AUTH=off               # one local account, no sign-in (development)
# GOOGLE_CLIENT_ID=                # enables "Continue with Google"
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=                # enables "Continue with GitHub"
# GITHUB_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=             # enables "Continue with Microsoft"
# MICROSOFT_CLIENT_SECRET=
# ALPHADESK_BASE_URL=              # public https origin: OAuth redirects and the agent host allowlist
# ALPHADESK_COOKIE_SECURE=1        # set behind HTTPS
# ALPHADESK_SECRET=                # session signing secret

# ── Accounts ─────────────────────────────────────────────────────────────────
# ALPHADESK_OWNER_EMAILS=          # comma list: the Admin page, never gated, panels kept warm
# ALPHADESK_TRIAL_DAYS=14
# ALPHADESK_BILLING_ENFORCE=off    # access gate: leave off when self-hosting; "on" for the managed service

# ── Payments (the managed service only; a self-hosted copy leaves these unset) ─
# With STRIPE_SECRET_KEY set, Stripe is the processor. Register
# <ALPHADESK_BASE_URL>/api/billing/webhook in Stripe for checkout.session.completed
# and customer.subscription.created / updated / deleted.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID_MONTHLY=         # $19 a month
# STRIPE_PRICE_ID_YEARLY=          # $190 a year

# ── Search by meaning (self-hosted embedding model) ──────────────────────────
# ALPHADESK_SEMANTIC_SEARCH=off    # word search only; skips the ~1.2 GB model
# ALPHADESK_EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
# ALPHADESK_SEMANTIC_THRESHOLD=0.50

# ── Keeping an owner's panels warm ───────────────────────────────────────────
# ALPHADESK_PREWARM=off            # stop replaying owners' reads in the background

# ── News ─────────────────────────────────────────────────────────────────────
NEWS_REFRESH_MINUTES=5             # the poll; Alpaca's news also streams live
NEWS_LOOKBACK_HOURS=72             # the window the news list opens on
# NEWS_KEEP_DAYS=7                 # stories deleted after this

# ── Chart honesty ────────────────────────────────────────────────────────────
# Below either floor, RSI and MACD are HIDDEN rather than drawn on data too
# sparse to support them.
CHART_MIN_COVERAGE=0.5             # share of a full 390-bar session
CHART_MAX_MEDIAN_GAP_MIN=2.0

# ── Extensions (optional) ────────────────────────────────────────────────────
# Comma-separated import paths; importing is enough, they register themselves.
# Installed packages exposing the `alphadesk.providers` entry point are found
# automatically.
ALPHADESK_PLUGINS=
# ALPHADESK_WIDGET_BACKENDS=       # external tile backends (docs/widgets.md)

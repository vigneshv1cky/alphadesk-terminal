# AlphaDesk configuration — copy to the repo root as .env and fill in.
# If you add keys, chmod 600 .env
#
# NO INLINE COMMENTS AFTER A VALUE. Docker's --env-file keeps everything
# after the "=" , comment and all, so `KEY=0.5  # note` reaches the app as
# the string "0.5  # note" and the container exits on start (2026-09-19).
# Python's own loader strips them, which is why this only bites in Docker.
# ──────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────
# Seals every reader's vendor keys in the database: 32 random bytes, base64.
#   python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
# Losing it makes every stored key unreadable.
ALPHADESK_VAULT_KEY=

# SEC EDGAR needs no key but REQUIRES a descriptive User-Agent with contact
# details; without one SEC throttles and then blocks the address for minutes.
SEC_USER_AGENT=AlphaDesk (you@example.com)

# ── Vendor keys (optional) ───────────────────────────────────────────────────
# Put your own keys here as ALPACA_API_KEY, ALPACA_SECRET_KEY, POLYGON_API_KEY,
# FINNHUB_API_KEY, ALPHAVANTAGE_API_KEY, FMP_API_KEY, COINGECKO_API_KEY. At
# start they are sealed into the account the server acts as (the local one with
# sign-in off, or the login's). Settings add or update keys and
# never delete them, and win over a key changed on the Account page at the next
# start. A request still reads keys only from the vault, never from here.
# Seal them without starting the server:  python -m alphadesk.main keys import-env

# ── Storage ──────────────────────────────────────────────────────────────────
# SQLite ledger + the SEC symbol-list cache
ALPHADESK_DATA=~/.alphadesk
# ALPHADESK_DATABASE_URL=          # Postgres instead of SQLite (Cloud SQL, or your own: postgresql://user:pass@host:5432/db).
#                                  # Postgres gets a word-search index; make sure the pg_trgm extension may be created.

# ── Server ───────────────────────────────────────────────────────────────────
# 0.0.0.0 when serving beyond localhost
DASHBOARD_HOST=127.0.0.1
# Cloud Run injects PORT; the image maps it
DASHBOARD_PORT=8000

# ── Sign-in (COMPULSORY by default) ──────────────────────────────────────────
# One user per server. With sign-in on, set the login below (required: the server will
# not start without it); there is no sign-up and no Google or GitHub sign-in.
# ALPHADESK_LOGIN_EMAIL=           # the one user's email (the account is keyed by it); any other account is refused
# ALPHADESK_LOGIN_PASSWORD_HASH=   # python -m alphadesk.main hash-password   (single-quote the value in a .env: it contains $)
# ALPHADESK_AUTH=off               # one local account, no sign-in (development)
# ALPHADESK_LOCAL_USER_EMAIL=      # with AUTH=off: act as this existing account (a server that began with accounts)
# ALPHADESK_PURGE_ON_KEY_REMOVAL=1 # delete a vendor's stored data when its key is removed (off by default)
# ALPHADESK_ACCESS_TOKEN=          # with AUTH=off: one shared secret in front of the server (16+ characters).
#                                  # Set it whenever the server is reachable beyond this machine.
# ALPHADESK_BASE_URL=              # public https origin: OAuth redirects and the agent host allowlist
# ALPHADESK_COOKIE_SECURE=1        # set behind HTTPS
# ALPHADESK_SECRET=                # session signing secret

# ── Names this open server answers to ────────────────────────────────────────
# ALPHADESK_ALLOWED_HOSTS=         # with sign-in off and no access token only localhost is answered; add other names here

# ── Keeping data ─────────────────────────────────────────────────────────────
# ALPHADESK_KEEP_DATA=forever      # or a number of days: keep the records longer than their defaults (7 days of news, 120 of forecasts)

# ── Search by meaning (self-hosted embedding model) ──────────────────────────
# ALPHADESK_SEMANTIC_SEARCH=off    # word search only; skips the ~1.2 GB model
# ALPHADESK_EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
# ALPHADESK_SEMANTIC_THRESHOLD=0.50

# ── Keeping your panels warm ───────────────────────────────────────────
# ALPHADESK_PREWARM=off            # stop replaying your recent reads in the background

# ── News ─────────────────────────────────────────────────────────────────────
# the poll, in minutes; Alpaca's news also streams live
NEWS_REFRESH_MINUTES=5
# the window the news list opens on, in hours
NEWS_LOOKBACK_HOURS=72
# NEWS_KEEP_DAYS=7                 # stories deleted after this

# ── Chart honesty ────────────────────────────────────────────────────────────
# Below either floor, RSI and MACD are HIDDEN rather than drawn on data too
# sparse to support them.
# share of a full 390-bar session
CHART_MIN_COVERAGE=0.5
CHART_MAX_MEDIAN_GAP_MIN=2.0

# ── Extensions (optional) ────────────────────────────────────────────────────
# Comma-separated import paths; importing is enough, they register themselves.
# Installed packages exposing the `alphadesk.providers` entry point are found
# automatically.
ALPHADESK_PLUGINS=
# ALPHADESK_WIDGET_BACKENDS=       # external tile backends (docs/widgets.md)
